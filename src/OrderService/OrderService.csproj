<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(RunConfiguration)' == 'http' " />
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.0.0" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
    <!-- Provides AddResilienceHandler (Retry, Circuit Breaker, Timeout, Rate Limiter) built on Polly v8. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.9.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Domain\Enums\" />
    <None Remove="Domain\ValueObjects\" />
    <None Remove="Domain\Exceptions\" />
    <None Remove="Domain\Entities\" />
    <None Remove="Controllers\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Domain\Enums\" />
    <Folder Include="Domain\ValueObjects\" />
    <Folder Include="Domain\Exceptions\" />
    <Folder Include="Domain\Entities\" />
    <Folder Include="Controllers\" />
  </ItemGroup>
</Project>
